{
  "architecture": "0.11",
  "core": {
    "name": "pey.core",
    "version": "0.2.2"
  },
  "adapters": {
    "router": "BrowserHistoryAdapter",
    "storage": "IndexedDBAdapter"
  },
  "ui": {
    "path": "./src/ui"
  },
  "plugins": [
    {
      "name": "pey.router",
      "version": "1.0.0",
      "path": "./node_modules/pey.router"
    },
    {
      "name": "pey.storage",
      "version": "0.4.0",
      "path": "./node_modules/pey.storage"
    },
    {
      "name": "parsinegar.app",
      "version": "0.1.0",
      "path": "./src/plugins/app"
    },
    {
      "name": "parsinegar.documents",
      "version": "0.1.0",
      "path": "./src/plugins/documents"
    }
  ],
  "config": {
    "pey.router": {
      "basePath": "/",
      "notFoundPath": "/not-found"
    },
    "pey.storage": {
      "databaseName": "parsinegar-db",
      "schemaVersion": 1,
      "stores": [
        {
          "name": "documents",
          "keyPath": "id",
          "indexes": [{ "name": "updatedAtIdx", "field": "updatedAt" }]
        }
      ]
    },
    "ui": {
      "theme": "system",
      "language": "fa",
      "direction": "rtl",
      "fallbackPath": "/",
      "assetBaseUrl": "./assets"
    }
  },
  "app": {
    "name": "parsinegar",
    "version": "0.1.0"
  }
}
